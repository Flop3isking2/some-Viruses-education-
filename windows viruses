        fn=next((f[1] for f in BYTEBEAT_FORMULAS if f[0]==name),BYTEBEAT_FORMULAS[0][1])
        self.result={
            "power":self.v_power.get()/100.0, "speed":self.v_speed.get(),
            "interval":self.v_interval.get(), "bitblt":self.v_bitblt.get(),
            "stretch":self.v_stretch.get(), "invert":self.v_invert.get(),
            "colorflood":self.v_colorflood.get(), "tiles":self.v_tiles.get(),
            "scroll":self.v_scroll.get(), "diagonal":self.v_diagonal.get(),
            "flash":self.v_flash.get(), "duplicate":self.v_duplicate.get(),
            "sound":self.v_sound.get(), "formula_fn":fn,
            "errors":self.v_errors.get(), "csod":self.v_csod.get(),
            "reboot":self.v_reboot.get(), "dvd":self.v_dvd.get(),
            "csod_time":self.v_csod_time.get(),
