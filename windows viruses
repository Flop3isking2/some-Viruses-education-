#  BYTEBEAT
# ══════════════════════════════════════════════════════════════
BYTEBEAT_FORMULAS = [
    ("t & t >> 8",
     lambda t: t & t >> 8),
    ("t >> 5 | (t>>2)*(t>>5)",
     lambda t: (t >> 5) | ((t >> 2) * (t >> 5))),
    ("2*(t>>5&t)-(t>>5)+t*(t>>14&14)",
     lambda t: 2*(t>>5 & t) - (t>>5) + t*(t>>14 & 14)),
    ("t+(t&t^t>>6)-t*(t>>9&...)",
     lambda t: t + (t & t ^ t >> 6) - t*(t>>9 & (2 if (t%16)==0 else 6) & t>>9)),
    ("t*((t>>15|1)^(t-1280^t)>>10)*t",
     lambda t: t*(t ^ t + (t>>15|1) ^ (t-1280^t)>>10)),
    ("bytebeat synth 6",
     lambda t: (t*((t//2>>10|t%16*t>>8)&8*t>>12&18))|(-(t//16))+64),
    ("t*(t&16384?6:5)*...",
     lambda t: t*(6 if t&16384 else 5)*(4-(1&t>>8))>>(3&t>>9)|(t|t*3)>>5),
    ("t*(t&4096?6:16+...)",
     lambda t: t*((6 if t&4096 else 16)+(1&t>>14))>>(3&t>>8)|(t>>(3 if t&4096 else 4))),
    ("complex conditional",
     lambda t: t*((7 if (t&4096 and t%65536<59392) else (t&7 if t&4096 else 16))
                  ^(1&t>>14))>>(3&(-(t))>>(2 if t&2048 else 10))),
    ("t * rand()",
     lambda t: t * random.randint(0, 255)),
]

SND_MEMORY = 0x0004; SND_ASYNC = 0x0001; SND_NODEFAULT = 0x0002
_wav_buf = None

def make_bytebeat_wav(fn, dur=3.0, sr=8000):
    n = int(sr*dur); s = bytearray(n)
    for i in range(n):
        try: s[i] = int(fn(i)) & 0xFF
        except: pass
    buf = io.BytesIO()
    buf.write(b'RIFF'); buf.write(struct.pack('<I',36+n))
    buf.write(b'WAVE'); buf.write(b'fmt ')
    buf.write(struct.pack('<IHHIIHH',16,1,1,sr,sr,1,8))
    buf.write(b'data'); buf.write(struct.pack('<I',n))
    buf.write(bytes(s)); return buf.getvalue()

def play_bytebeat(fn):
    global _wav_buf
    def _p():
        global _wav_buf
        try:
            wav = make_bytebeat_wav(fn)
            _wav_buf = (ctypes.c_char*len(wav))(*wav)
            winmm.PlaySoundA(_wav_buf,None,SND_MEMORY|SND_ASYNC|SND_NODEFAULT)
        except: pass
    threading.Thread(target=_p,daemon=True).start()

def stop_sound():
    try: winmm.PlaySoundA(None,None,0)
    except: pass

