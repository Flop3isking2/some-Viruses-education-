def get_dc():    return user32.GetDC(user32.GetDesktopWindow())
def rel_dc(dc):  user32.ReleaseDC(user32.GetDesktopWindow(),dc)

def fx_bitblt_shift(dc,p,cfg):
    n=int(3+p*25*cfg["power"]); ms=int(SW*(0.04+p*0.5*cfg["power"]))
    for _ in range(n):
        sx=random.randint(0,SW-1); sy=random.randint(0,SH-1)
        w=min(random.randint(40,max(41,int(180+p*SW*0.4))),SW-sx)
        h=min(random.randint(1,max(2,int(8+p*SH*0.12))),SH-sy)
        dx=max(0,min(sx+random.randint(-ms,ms),SW-w))
        dy=max(0,min(sy+random.randint(-3,3),SH-h))
        gdi32.BitBlt(dc,dx,dy,w,h,dc,sx,sy,
                     random.choice([SRCCOPY,SRCINVERT,PATINVERT,MERGECOPY]))

def fx_stretch(dc,p,cfg):
    mem=gdi32.CreateCompatibleDC(dc); bmp=gdi32.CreateCompatibleBitmap(dc,SW,SH)
    gdi32.SelectObject(mem,bmp); gdi32.BitBlt(mem,0,0,SW,SH,dc,0,0,SRCCOPY)
    for _ in range(int(2+p*10*cfg["power"])):
        sy=random.randint(0,SH-2); sh=random.randint(1,max(2,int(SH*0.05)))
        dy=max(0,min(sy+random.randint(-int(SH*0.08*p),int(SH*0.08*p)),SH-sh))
        dw=random.randint(int(SW*0.3),SW); dx=random.randint(0,SW-dw)
        gdi32.StretchBlt(dc,dx,dy,dw,sh*random.randint(2,5),mem,0,sy,SW,sh,SRCCOPY)
    gdi32.DeleteObject(bmp); gdi32.DeleteDC(mem)

def fx_invert(dc,p,cfg):
    if p>0.8*cfg["power"] and random.random()<0.3:
        gdi32.BitBlt(dc,0,0,SW,SH,dc,0,0,DSTINVERT)
    else:
        for _ in range(int(1+p*10*cfg["power"])):
            x=random.randint(0,SW-2); y=random.randint(0,SH-2)
            w=min(random.randint(10,max(11,int(SW*0.35*p))),SW-x)
            h=min(random.randint(2,max(3,int(SH*0.08*p))),SH-y)
            gdi32.BitBlt(dc,x,y,w,h,dc,x,y,DSTINVERT)

def fx_colorflood(dc,p,cfg):
    for _ in range(int(p*8*cfg["power"])):
        br=gdi32.CreateSolidBrush(random.choice([0x8B0000,0x00A5FF,0x0000CD,0xFF6400,0x8B008B]))
        x=random.randint(0,SW-1); y=random.randint(0,SH-1)
        w=random.randint(5,max(6,int(SW*0.2*p))); h=random.randint(1,max(2,int(SH*0.05*p)))
        rc=(ctypes.c_long*4)(x,y,min(x+w,SW),min(y+h,SH))
        user32.FillRect(dc,rc,br); gdi32.DeleteObject(br)

def fx_tiles(dc,p,cfg):
    if p<0.3: return
    sx=random.randint(0,SW//2); sy=random.randint(0,SH//2)
    w=random.randint(16,100); h=random.randint(16,80)
    for _ in range(int(p*18*cfg["power"])):
        gdi32.BitBlt(dc,random.randint(0,max(1,SW-w)),random.randint(0,max(1,SH-h)),
                     w,h,dc,sx,sy,random.choice([SRCCOPY,SRCINVERT,PATINVERT]))

def fx_scroll(dc,p,cfg):
    dy=int(p*SH*0.1*cfg["power"]*random.choice([-1,1]))
    if abs(dy)<2: return
    if dy>0: gdi32.BitBlt(dc,0,dy,SW,SH-dy,dc,0,0,SRCCOPY)
    else:    gdi32.BitBlt(dc,0,0,SW,SH+dy,dc,0,-dy,SRCCOPY)

def fx_diagonal(dc,p,cfg):
    ox=int(p*SW*0.07*cfg["power"]*math.sin(time.time()*3))
    oy=int(p*SH*0.03*cfg["power"])
    w=SW-abs(ox); h=SH-abs(oy)
    if w>0 and h>0:
        gdi32.BitBlt(dc,max(0,ox),max(0,oy),w,h,dc,max(0,-ox),max(0,-oy),
                     random.choice([SRCCOPY,SRCINVERT]))

def fx_flash(dc):
    gdi32.BitBlt(dc,0,0,SW,SH,dc,0,0,random.choice([WHITENESS,BLACKNESS,DSTINVERT]))

def fx_duplicate(dc,p):
    mem=gdi32.CreateCompatibleDC(dc); bmp=gdi32.CreateCompatibleBitmap(dc,SW,SH)
    gdi32.SelectObject(mem,bmp); gdi32.BitBlt(mem,0,0,SW,SH,dc,0,0,SRCCOPY)
    scale=0.6; x=random.randint(0,SW//3); y=random.randint(0,SH//3)
    for _ in range(5):
        nw=max(10,int(SW*scale)); nh=max(10,int(SH*scale))
        nx=min(max(0,x),SW-nw); ny=min(max(0,y),SH-nh)
        gdi32.StretchBlt(dc,nx,ny,nw,nh,mem,0,0,SW,SH,SRCCOPY)
        scale*=0.55; x=nx+random.randint(-30,30); y=ny+random.randint(-30,30)
        x=max(0,min(x,SW-10)); y=max(0,min(y,SH-10))
    gdi32.DeleteObject(bmp); gdi32.DeleteDC(mem)

def draw_csod(progress):
    dc=get_dc()
    br=gdi32.CreateSolidBrush(0); rc=(ctypes.c_long*4)(0,0,SW,SH)
    user32.FillRect(dc,rc,br); gdi32.DeleteObject(br)
    fb=gdi32.CreateFontA(90,0,0,0,400,0,0,0,0,0,0,0,0,b"Segoe UI")
    fm=gdi32.CreateFontA(26,0,0,0,300,0,0,0,0,0,0,0,0,b"Segoe UI")
    fs=gdi32.CreateFontA(17,0,0,0,300,0,0,0,0,0,0,0,0,b"Segoe UI")
    gdi32.SetBkMode(dc,1); gdi32.SetTextColor(dc,0x00FFFFFF)
    cx=SW//2; sz=wt.SIZE(); old=gdi32.SelectObject(dc,fb)
    face=b":("; gdi32.GetTextExtentPoint32A(dc,face,len(face),ctypes.byref(sz))
    gdi32.TextOutA(dc,cx-sz.cx//2,SH//2-230,face,len(face))
    gdi32.SelectObject(dc,fm)
    for i,ln in enumerate([b"Your PC ran into a problem and needs to restart.",
                            b"We're just collecting some error info, and then",
                            b"we'll restart for you."]):
        gdi32.GetTextExtentPoint32A(dc,ln,len(ln),ctypes.byref(sz))
        gdi32.TextOutA(dc,cx-sz.cx//2,SH//2-70+i*34,ln,len(ln))
    gdi32.SelectObject(dc,fb)
    pct=f"{int(progress*100)}%".encode()
    gdi32.GetTextExtentPoint32A(dc,pct,len(pct),ctypes.byref(sz))
    gdi32.TextOutA(dc,cx-sz.cx//2,SH//2+70,pct,len(pct))
    gdi32.SelectObject(dc,fs)
    ec=b"Stop code: SALINEWIN_CORRUPTION_FAULT"
    gdi32.GetTextExtentPoint32A(dc,ec,len(ec),ctypes.byref(sz))
    gdi32.TextOutA(dc,cx-sz.cx//2,SH//2+190,ec,len(ec))
    gdi32.SelectObject(dc,old)
    for f in [fb,fm,fs]: gdi32.DeleteObject(f)
    rel_dc(dc)

def fake_reboot():
    dc=get_dc()
    br=gdi32.CreateSolidBrush(0); rc=(ctypes.c_long*4)(0,0,SW,SH)
    user32.FillRect(dc,rc,br); gdi32.DeleteObject(br); rel_dc(dc)
    time.sleep(1.5)
    dc=get_dc()
    br=gdi32.CreateSolidBrush(0); rc=(ctypes.c_long*4)(0,0,SW,SH)
    user32.FillRect(dc,rc,br); gdi32.DeleteObject(br)
    sq=40; gap=5; ox=SW//2-sq-gap//2; oy=SH//2-sq-gap//2
    for col,(px,py) in zip([0x00F25022,0x007FBA00,0x00FFB900,0x0000A4EF],
                           [(ox,oy),(ox+sq+gap,oy),(ox,oy+sq+gap),(ox+sq+gap,oy+sq+gap)]):
        br2=gdi32.CreateSolidBrush(col); rc2=(ctypes.c_long*4)(px,py,px+sq,py+sq)
        user32.FillRect(dc,rc2,br2); gdi32.DeleteObject(br2)
    fnt=gdi32.CreateFontA(16,0,0,0,300,0,0,0,0,0,0,0,0,b"Segoe UI")
    old=gdi32.SelectObject(dc,fnt); gdi32.SetBkMode(dc,1); gdi32.SetTextColor(dc,0x00AAAAAA)
    msg=b"Restarting..."; sz=wt.SIZE()
    gdi32.GetTextExtentPoint32A(dc,msg,len(msg),ctypes.byref(sz))
    gdi32.TextOutA(dc,SW//2-sz.cx//2,SH//2+130,msg,len(msg))
    gdi32.SelectObject(dc,old); gdi32.DeleteObject(fnt); rel_dc(dc)
    time.sleep(3)

def get_all_windows():
    hwnds=[]
    def cb(hwnd,_):
        if user32.IsWindowVisible(hwnd):
            buf=ctypes.create_string_buffer(256)
            user32.GetWindowTextA(hwnd,buf,256)
            if buf.value: hwnds.append(hwnd)
        return True
    user32.EnumWindows(ctypes.WINFUNCTYPE(ctypes.c_bool,wt.HWND,wt.LPARAM)(cb),0)
    return hwnds

def dvd_bounce(stop_ev):
    hwnds=get_all_windows()
    if not hwnds: return
    windows=[]
    for hwnd in hwnds[:20]:
        rc=wt.RECT(); user32.GetWindowRect(hwnd,ctypes.byref(rc))
        w=rc.right-rc.left; h=rc.bottom-rc.top
        windows.append([hwnd,float(rc.left),float(rc.top),w,h,
                        random.choice([-1,1])*random.randint(3,8),
                        random.choice([-1,1])*random.randint(3,8)])
    while not stop_ev.is_set():
        for win in windows:
            hwnd,x,y,w,h,vx,vy=win
            x+=vx; y+=vy
            if x<0:    x=0;    vx=abs(vx)
            if y<0:    y=0;    vy=abs(vy)
            if x+w>SW: x=SW-w; vx=-abs(vx)
            if y+h>SH: y=SH-h; vy=-abs(vy)
            win[1]=x; win[2]=y; win[5]=vx; win[6]=vy
