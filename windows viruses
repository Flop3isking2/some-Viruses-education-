SRCCOPY   = 0x00CC0020
SRCINVERT = 0x00660046
MERGECOPY = 0x00C000CA
PATINVERT = 0x005A0049
DSTINVERT = 0x00550009
BLACKNESS = 0x00000042
WHITENESS = 0x00FF0062

# ══════════════════════════════════════════════════════════════
#  ГЛОБАЛЬНЫЙ ESC — через SetWindowsHookEx в отдельном потоке
#  с собственным message pump (AttachThreadInput не нужен)
# ══════════════════════════════════════════════════════════════
#  ГЛОБАЛЬНЫЙ ESC — GetAsyncKeyState (работает всегда, без хуков)
# ══════════════════════════════════════════════════════════════
_esc_event = threading.Event()

def start_esc_hook():
    def _poll():
        while not _esc_event.is_set():
            if user32.GetAsyncKeyState(0x1B) & 0x8000:
                _esc_event.set()
                break
            time.sleep(0.05)
    threading.Thread(target=_poll, daemon=True).start()

